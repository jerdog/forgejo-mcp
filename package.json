{
  "name": "forgejo-mcp",
  "version": "0.1.0",
  "description": "MCP server for managing Gitea/Forgejo repositories, issues, pull requests and more",
  "license": "MIT",
  "type": "module",
  "bin": {
    "forgejo-mcp": "dist/stdio.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/stdio.js",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/stdio.js",
    "check": "node dist/stdio.js --check",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
